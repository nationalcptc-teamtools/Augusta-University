# CPTC domain context — shell-sourceable KEY=VALUE lines.
# Loaded automatically by lib/common.sh so you don't retype domain details per
# script. Separate from scope.txt (which holds target IPs/CIDRs only).
#
# Every value here can be overridden per-run with a flag on any script:
#   DOMAIN       -> -d / --domain
#   NETBIOS      -> --netbios
#   DC_IP        -> --dc-ip
#   DC_HOSTNAME  -> --dc-hostname
#
# BASE_DN is auto-derived from DOMAIN (support.htb -> DC=support,DC=htb) — do not
# store it here.
#
# Edit these for your engagement:
DOMAIN=10.129.159.215
NETBIOS=checkpoint
DC_IP=10.129.159.215
DC_HOSTNAME=
